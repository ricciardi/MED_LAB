# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# SQLite é criado em instance/medlab.db.
DATABASE_URL=sqlite:///medlab.db
# MySQL no cPanel (codifique caracteres especiais da senha na URL):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost/banco?charset=utf8mb4
# Chave SOMENTE no servidor. Nunca adicione seu .env ao GitHub.
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT=40
# Somente importação pelo terminal: chamadas de adaptação mais longas (máximo 180s).
AI_IMPORT_TIMEOUT=120
# Preparação no terminal: máquina dedicada aceita até 256 tarefas.
# O cPanel simples deve usar --adapt-workers 1 a 4 conforme seus recursos.
AI_IMPORT_WORKER_LIMIT=16
MAX_DAILY_AI_REQUESTS=120
# Voz sem API paga: Whisper + Kokoro no navegador, ativados pelo aluno.
# ZIP inclui runtimes; checkout: python scripts/prepare_voice_assets.py
# Os modelos são baixados no aparelho no primeiro uso e ficam em cache.
LOCAL_VOICE_ENABLED=true
# Produção exige HTTPS. Use false apenas no preview local HTTP.
SESSION_COOKIE_SECURE=true
# Endereço exclusivo, ausente da navegação pública.
ADMIN_PATH=/gestao-medlab
# true ativa respostas fixas DEMONSTRATIVAS, sem chamadas à IA.
DEMO_MODE=false
# Para scripts legados de pesquisa, opcionais:
# EASYMED_API_KEY=
# EASYMED_BASE_URL=https://api.deepseek.com
# EASYMED_MODEL=deepseek-flash

# Instalação destinada exclusivamente a uso sem finalidade comercial.
CASE_REUSE_SCOPE=noncommercial
# Permite considerar fontes ND somente para extração de fatos clínicos e redação
# original, com auditoria e revisão. Não autoriza traduzir ou adaptar o artigo.
CASE_ALLOW_CLINICAL_FACTS=false
