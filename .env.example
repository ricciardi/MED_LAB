# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# SQLite é criado em instance/medlab.db.
DATABASE_URL=sqlite:///medlab.db
# MySQL no cPanel (codifique caracteres especiais da senha na URL):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost/banco?charset=utf8mb4
# Chave SOMENTE no servidor. Nunca adicione seu .env ao GitHub.
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT=40
MAX_DAILY_AI_REQUESTS=120
# Produção exige HTTPS. Use false apenas no preview local HTTP.
SESSION_COOKIE_SECURE=true
# Endereço exclusivo, ausente da navegação pública.
ADMIN_PATH=/gestao-medlab
# true ativa respostas fixas DEMONSTRATIVAS, sem chamadas à IA.
DEMO_MODE=false
# Para scripts legados de pesquisa, opcionais:
# EASYMED_API_KEY=
# EASYMED_BASE_URL=https://api.deepseek.com
# EASYMED_MODEL=deepseek-flash
